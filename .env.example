# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables (Production).

# Neon: use the POOLED connection string (host contains "-pooler") for the app…
DATABASE_URL=postgres://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# …and the direct one for migrations. Neon's Vercel integration sets both.
DATABASE_URL_UNPOOLED=postgres://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# 32+ random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# The public URL of this app (no trailing slash)
BETTER_AUTH_URL=https://admin.4cs.al

# Random string; Vercel sends it to /api/cron/daily as a Bearer token.
CRON_SECRET=

# Optional locally (emails are printed to the console without it).
RESEND_API_KEY=
# Needs 4cs.al verified in Resend to email anyone but the Resend account owner.
EMAIL_FROM="4CS Admin <admin@4cs.al>"
